# Copy to .env and fill in. Never commit .env — it is gitignored.

# Facebook Graph API — long-lived Page Access Token
# (valid 60 days; set a calendar reminder to refresh it every 50 days)
FB_ACCESS_TOKEN=your_facebook_page_access_token

# Google Gemini
GOOGLE_API_KEY=your_google_api_key

# Line Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# Scheduler (24-hour format, in TIMEZONE below)
# Default: 08:00 Thailand time (Asia/Bangkok, UTC+7) — Rangsit students should
# have the day's menus before their first class.
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Bangkok

# Web server
HOST=0.0.0.0
PORT=5000
SERVER_THREADS=8
WEBHOOK_WORKERS=4

# Logging
LOG_LEVEL=INFO
# LOG_FILE=/var/log/menubot/bot.log
